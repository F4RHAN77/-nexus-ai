{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-ai",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "MY_RATE_LIMITER",
      "namespace_id": "20261110",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "nexus-ai-tasks",
        "binding": "AI_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "nexus-ai-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  }
}
